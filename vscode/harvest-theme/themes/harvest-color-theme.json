  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#A8937C", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string", "string.quoted"], "settings": { "foreground": "#E9B949" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#7CC4B8" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#F4A663" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#C58FB8" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#C4B19B" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#E8863A" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#7FA8D1" } },
    { "scope": ["variable", "meta.definition.variable", "variable.other"], "settings": { "foreground": "#F3E6D3" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#F4CFA8", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#DAAFCF", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#A3C3E3" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#E8863A" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#E9B949" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "support.module"], "settings": { "foreground": "#7CC4B8" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#DAAFCF" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E8693F" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#E8863A", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#7CC4B8" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#E9B949" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#5FB3C4" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#E8693F" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#E9B949" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#F4CFA8", "italic": true },
    "property": "#A3C3E3",
    "enumMember": "#F4A663",
    "namespace": "#7CC4B8",
    "decorator": "#DAAFCF"
  }
}
